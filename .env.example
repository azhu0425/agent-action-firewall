# Copy to .env for local overrides. No secrets are needed for the core path.

# Path to the firewall policy file (YAML). Missing or invalid policy => every call is DENIED.
FIREWALL_POLICY_PATH=policy/policy.yaml

# Append-only, hash-chained audit log (JSONL). Holds argument hashes, never values.
FIREWALL_AUDIT_LOG=audit/audit.jsonl

# dev | test | prod. Shadow mode is refused in prod unless FIREWALL_ALLOW_SHADOW_IN_PROD=true.
APP_ENV=dev
FIREWALL_ALLOW_SHADOW_IN_PROD=false

# Log level for the JSON logs (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
