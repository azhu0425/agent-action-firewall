# The runtime image copies only firewall/, policy/, eval/corpus/ and examples/ (see Dockerfile).
# The verify image copies the whole context, so this file keeps secrets, VCS data, caches and
# local state out of every build.
.git
.venv
venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
coverage.xml
htmlcov
.env
.env.*
!.env.example
audit
*.audit.jsonl
.claude/worktrees
.claude/settings.local.json
.claude/plans
*exercise-brief*.md
